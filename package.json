{
  "name": "firefly-audio-video",
  "version": "0.1.0",
  "description": "Node/TypeScript client for Adobe Firefly Services' audio/video (DGR) API — promises that resolve with the finished asset, native preset/.epr authoring, redacted logging, and an npx CLI.",
  "keywords": [
    "adobe",
    "firefly",
    "firefly-services",
    "audio-video",
    "dgr",
    "video",
    "render",
    "mogrt",
    "prores",
    "hevc",
    "sdk",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "ellyseum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ellyseum/firefly-audio-video.git"
  },
  "homepage": "https://github.com/ellyseum/firefly-audio-video#readme",
  "bugs": {
    "url": "https://github.com/ellyseum/firefly-audio-video/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "dgr": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "runtime-smoke": "node scripts/runtime-smoke.mjs",
    "bundle-smoke": "node scripts/bundle-smoke.mjs",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@adobe/aio-lib-files": "^4.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@azure/storage-blob": "^12.4.0"
  },
  "peerDependenciesMeta": {
    "@adobe/aio-lib-files": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    }
  },
  "dependencies": {
    "@adobe/firefly-services-common-apis": "^2.0.0",
    "commander": "^13.1.0",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@adobe/aio-lib-files": "^4.1.4",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@azure/storage-blob": "^12.34.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "4.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pkg-pr-new": "^0.0.88",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "undici": "^8.11.2",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
